# ── 資料庫（Neon PostgreSQL）─────────────────────────────────────────────────
# Neon Console → 專案 → Connect → Connection string（Pooled）
# 本機：複製本檔為 .env.local 後填入；Vercel：Settings → Environment Variables
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx-xxxxxxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── 現場照片儲存（Vercel Blob）───────────────────────────────────────────────
# Vercel → Storage → Blob → 建立 store 後會自動寫入這個變數；本機開發可留空
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# ── 顯示設定（可選）─────────────────────────────────────────────────────────
SITE_TITLE=澳門古樹保育研究平台
